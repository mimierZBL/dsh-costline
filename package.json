{
  "name": "dsh-costline",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "author": "DSH Costline contributors",
  "homepage": "https://github.com/REPLACE_GITHUB_OWNER/dsh-costline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REPLACE_GITHUB_OWNER/dsh-costline.git"
  },
  "bugs": {
    "url": "https://github.com/REPLACE_GITHUB_OWNER/dsh-costline/issues"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "cost", "token", "usage"],
  "description": "Whole-turn token usage, local DeepSeek cost estimates, and a session ledger for DSH.",
  "type": "commonjs",
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0",
    "node": ">=24.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-token-meter": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "^4.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.compat.js",
    "client.pricing.js",
    "ledger.host.js",
    "client.ledger.js",
    "client.ledger-view.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
